{
  "name": "film-engine-v2",
  "productName": "Film Engine",
  "version": "1.0.1",
  "private": true,
  "description": "Film Engine as a React + Electron app",
  "main": "electron/main.cjs",
  "scripts": {
    "split": "node tools/split-map.js",
    "dev": "npm run split && concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env FE_DEV_URL=http://localhost:5173 electron .\"",
    "web": "npm run split && vite",
    "build": "npm run split && vite build",
    "start": "electron .",
    "test": "node --test tools/tests/*.test.js && vitest run",
    "smoke": "npm run build && electron . --smoke",
    "parity": "sh tools/parity-run.sh",
    "test:backend": "node tools/assemble-page.js && node tools/backend-tests.js",
    "pretest": "node tools/assemble-page.js",
    "test:ui": "vitest run",
    "postinstall": "node tools/name-dev-electron.js",
    "icons": "python3 tools/make-mac-icon.py && node tools/name-dev-electron.js",
    "dist:mac": "npm run build && node scripts/bundle-node.cjs && electron-builder --mac dmg --x64"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "acorn": "^8.14.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3",
    "jsdom": "^25.0.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.algofields.filmengine",
    "productName": "Film Engine",
    "copyright": "Algofields",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asar": false,
    "npmRebuild": false,
    "files": [
      "package.json",
      "electron/**",
      "dist/**",
      "backend/**",
      "!backend/tests/**",
      "!**/__pycache__/**",
      "!backend/**/*.log",
      "!**/.DS_Store"
    ],
    "extraResources": [
      {
        "from": "build/node/node",
        "to": "node/node"
      },
      {
        "from": "backend/node_modules",
        "to": "app/backend/node_modules",
        "filter": [
          "**/*",
          "!**/test/**",
          "!**/*.md"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.icns",
      "category": "public.app-category.video",
      "identity": null,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Film Engine ${version}",
      "artifactName": "Film Engine-${version}-${arch}.${ext}"
    }
  },
  "author": {
    "name": "Manny Henri",
    "email": "manny@algofields.com"
  }
}
