{ "id": "fake-depth", "name": "Fake Depth", "description": "Settings that apply to one choice only.", "script": "../fake_engine.py",
  "accepts": "video", "range": "whole", "out": { "flag": "--out", "kind": "file", "ext": ".json" },
  "options": [
    { "name": "effect", "flag": "--effect", "type": "select", "label": "Effect", "default": "dof",
      "choices": [ { "value": "dof", "label": "Depth of Field" }, { "value": "fog", "label": "Fog" } ] },
    { "name": "blur", "flag": "--blur", "type": "slider", "label": "Blur amount", "default": 1, "min": 0, "max": 3, "step": 0.1, "when": { "effect": ["dof"] } },
    { "name": "density", "flag": "--density", "type": "slider", "label": "Fog density", "default": 0.6, "min": 0, "max": 3, "step": 0.1, "when": { "effect": ["fog"] } } ] }
