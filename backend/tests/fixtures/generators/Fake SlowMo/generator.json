{ "id": "fake-slowmo", "name": "Fake SlowMo", "description": "Section tool for tests.", "script": "../fake_engine.py",
  "accepts": "video", "range": "section", "out": { "flag": "--out", "kind": "file", "ext": ".json" },
  "options": [
    { "name": "factor", "flag": "--factor", "type": "select", "label": "Slow down", "default": 4,
      "choices": [ { "value": 2, "label": "2×" }, { "value": 4, "label": "4×" } ] },
    { "name": "scene", "flag": "--scene", "type": "slider", "label": "Cut sensitivity", "default": 0.3, "min": 0.1, "max": 0.6, "step": 0.05 },
    { "name": "compare", "flag": "--compare", "type": "checkbox", "label": "Side-by-side", "default": false } ] }
